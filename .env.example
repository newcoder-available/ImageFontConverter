# LOCALIZE AI — Environment Configuration
# Copy this file to .env and configure your desired AI provider credentials.

# AI Provider Selection: mock | openai | gemini | anthropic | self-hosted
AI_PROVIDER=openai

# OpenAI API Configuration (Server-Side Only - Never exposed to client)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_VISION_MODEL=gpt-4o
OPENAI_TRANSLATION_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=dall-e-2
OPENAI_MAX_QA_ATTEMPTS=3

# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Anthropic Claude API Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Self-Hosted / Local LLM Endpoint (e.g. Ollama, vLLM, FastChat)
SELF_HOSTED_ENDPOINT=http://localhost:11434

# Inpainting Engine Method: telea | ns
INPAINT_METHOD=telea
INPAINT_RADIUS=4

# Storage Provider: local | s3 | gcs
STORAGE_PROVIDER=local

# Application Server Ports
PORT=8000
HOST=0.0.0.0
